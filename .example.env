# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:3000
IS_PRODUCTION=false

# Database Configuration (PostgreSQL Connection String)
DB_URL=postgres://postgres:postgres@localhost:5432/identity_db?sslmode=disable

# JWT & Authentication Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_DOMAIN=localhost

# SMTP Mailer Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Identity Auth <noreply@yourdomain.com>